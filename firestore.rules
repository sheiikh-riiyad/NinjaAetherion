rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin == true;
    }
    function stageRank(stage) {
      return {'Requested': 0, 'Accepted': 1, 'Building': 2, 'Review': 3, 'Delivered': 4}[stage];
    }
    function validOrderUrl(url) {
      return url is string && url.size() <= 2000 && (url == '' || url.matches('^https?://.+'));
    }
    match /orders/{orderId} {
      function owner() { return request.auth != null && resource.data.clientId == request.auth.uid; }
      allow read: if owner() || isAdmin();
      allow create: if request.auth != null && !isAdmin()
        && request.resource.data.keys().hasAll(['clientId', 'clientName', 'service', 'title', 'description', 'budget', 'deadline', 'referenceUrl', 'status', 'update', 'deliveryUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['clientId', 'clientName', 'service', 'title', 'description', 'budget', 'deadline', 'referenceUrl', 'status', 'update', 'deliveryUrl', 'createdAt', 'updatedAt'])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.clientName == (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name == '' ? 'Client' : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name)
        && request.resource.data.service in ['Website', 'Redesign', 'Bug fix', 'Custom project']
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 150
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 4000
        && request.resource.data.budget is string && request.resource.data.budget.size() <= 100
        && request.resource.data.deadline is string && (request.resource.data.deadline == '' || request.resource.data.deadline.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$'))
        && validOrderUrl(request.resource.data.referenceUrl)
        && request.resource.data.status == 'Requested' && request.resource.data.update == '' && request.resource.data.deliveryUrl == ''
        && request.resource.data.createdAt == request.time && request.resource.data.updatedAt == request.time;
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'update', 'deliveryUrl', 'updatedAt'])
        && request.resource.data.status in ['Requested', 'Accepted', 'Building', 'Review', 'Delivered']
        && stageRank(request.resource.data.status) >= stageRank(resource.data.status)
        && stageRank(request.resource.data.status) <= stageRank(resource.data.status) + 1
        && request.resource.data.update is string && request.resource.data.update.size() > 0 && request.resource.data.update.size() <= 2000
        && validOrderUrl(request.resource.data.deliveryUrl)
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
      match /updates/{updateId} {
        allow read: if request.auth != null && (isAdmin() || get(/databases/$(database)/documents/orders/$(orderId)).data.clientId == request.auth.uid);
        allow create: if isAdmin()
          && request.resource.data.keys().hasAll(['status', 'note', 'createdAt']) && request.resource.data.keys().hasOnly(['status', 'note', 'createdAt'])
          && request.resource.data.status == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.status
          && request.resource.data.note == getAfter(/databases/$(database)/documents/orders/$(orderId)).data.update
          && getAfter(/databases/$(database)/documents/orders/$(orderId)).data.updatedAt == request.time
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /orderReviews/{orderId} {
      allow read: if (resource != null && resource.data.public == true) || isAdmin()
        || (request.auth != null && get(/databases/$(database)/documents/orders/$(orderId)).data.clientId == request.auth.uid);
      allow create: if request.auth != null
        && get(/databases/$(database)/documents/orders/$(orderId)).data.clientId == request.auth.uid
        && get(/databases/$(database)/documents/orders/$(orderId)).data.status == 'Delivered'
        && request.resource.data.keys().hasAll(['clientId', 'clientName', 'workRating', 'websiteRating', 'text', 'public', 'createdAt'])
        && request.resource.data.keys().hasOnly(['clientId', 'clientName', 'workRating', 'websiteRating', 'text', 'public', 'createdAt'])
        && request.resource.data.clientId == request.auth.uid
        && request.resource.data.clientName == get(/databases/$(database)/documents/orders/$(orderId)).data.clientName
        && request.resource.data.workRating is int && request.resource.data.workRating >= 1 && request.resource.data.workRating <= 5
        && request.resource.data.websiteRating is int && request.resource.data.websiteRating >= 1 && request.resource.data.websiteRating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() > 0 && request.resource.data.text.size() <= 2000
        && request.resource.data.public is bool && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
    }
    match /connectedPeople/{userId} {
      allow read: if true;
      allow create, update: if isAdmin()
        && get(/databases/$(database)/documents/users/$(userId)).data.admin == false
        && request.resource.data.keys().hasAll(['name', 'workTitle', 'workDescription', 'workUrl', 'updatedAt'])
        && request.resource.data.keys().hasOnly(['name', 'workTitle', 'workDescription', 'workUrl', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.workTitle is string && request.resource.data.workTitle.size() > 0 && request.resource.data.workTitle.size() <= 150
        && request.resource.data.workDescription is string && request.resource.data.workDescription.size() <= 1000
        && request.resource.data.workUrl is string && request.resource.data.workUrl.size() <= 2000
        && (request.resource.data.workUrl == '' || request.resource.data.workUrl.matches('^https?://.+'))
        && request.resource.data.updatedAt == request.time;
      allow delete: if isAdmin();
    }
    match /peerChats/{chatId} {
      function member() {
        return request.auth != null && request.auth.uid in get(/databases/$(database)/documents/peerChats/$(chatId)).data.members;
      }
      // A missing thread contains no data; permitting this get allows atomic creation.
      allow get: if request.auth != null && (!exists(/databases/$(database)/documents/peerChats/$(chatId)) || request.auth.uid in resource.data.members);
      allow list: if request.auth != null && request.auth.uid in resource.data.members;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll(['members', 'names', 'createdAt'])
        && request.resource.data.keys().hasOnly(['members', 'names', 'createdAt'])
        && request.resource.data.members is list && request.resource.data.members.size() == 2
        && request.resource.data.members[0] == request.auth.uid
        && request.resource.data.members[1] is string && request.resource.data.members[1] != request.auth.uid
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && exists(/databases/$(database)/documents/users/$(request.resource.data.members[1]))
        && exists(/databases/$(database)/documents/connectedPeople/$(request.resource.data.members[1]))
        && request.resource.data.names is list && request.resource.data.names.size() == 2
        && request.resource.data.names[0] == (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name == '' ? 'Client' : get(/databases/$(database)/documents/users/$(request.auth.uid)).data.name)
        && request.resource.data.names[1] == get(/databases/$(database)/documents/connectedPeople/$(request.resource.data.members[1])).data.name
        && request.resource.data.createdAt == request.time;
      allow update, delete: if false;
      match /chatReads/{readerId} {
        allow read: if member() && request.auth.uid == readerId;
        allow create: if member() && request.auth.uid == readerId
          && request.resource.data.keys().hasAll(['lastReadAt']) && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt is timestamp && request.resource.data.lastReadAt <= request.time;
        allow update: if member() && request.auth.uid == readerId
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt is timestamp && request.resource.data.lastReadAt <= request.time
          && request.resource.data.lastReadAt >= resource.data.lastReadAt;
        allow delete: if false;
      }
      match /messages/{messageId} {
        function validReply() {
          let reply = request.resource.data.reply;
          return reply is map && reply.keys().hasAll(['messageId', 'text', 'senderId'])
            && reply.keys().hasOnly(['messageId', 'text', 'senderId'])
            && reply.messageId is string && reply.messageId.size() <= 128 && reply.messageId.matches('^[^/]+$')
            && exists(/databases/$(database)/documents/peerChats/$(chatId)/messages/$(reply.messageId))
            && reply.text == get(/databases/$(database)/documents/peerChats/$(chatId)/messages/$(reply.messageId)).data.text
            && reply.senderId == get(/databases/$(database)/documents/peerChats/$(chatId)/messages/$(reply.messageId)).data.senderId;
        }
        function validAttachment() {
          let file = request.resource.data.attachment;
          return file is map && file.keys().hasAll(['path', 'name', 'size', 'type'])
            && file.keys().hasOnly(['path', 'name', 'size', 'type'])
            && file.path == 'peer/' + chatId + '/' + request.auth.uid + '/' + messageId + '/attachment'
            && file.name is string && file.name.size() > 0 && file.name.size() <= 255
            && file.type is string && file.type.size() > 0 && file.type.size() <= 255
            && file.size is int && file.size > 0 && file.size <= 20 * 1024 * 1024;
        }
        allow read: if member();
        allow create: if member()
          && request.resource.data.keys().hasAll(['text', 'senderId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt', 'reply', 'attachment'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 2000
          && (request.resource.data.text.size() > 0 || 'attachment' in request.resource.data)
          && (!('reply' in request.resource.data) || validReply())
          && (!('attachment' in request.resource.data) || validAttachment())
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
    match /presence/{sessionId} {
      allow read: if request.auth != null && (isAdmin() || resource.data.admin == true);
      allow create, update: if request.auth != null
        && request.resource.data.keys().hasAll(['uid', 'admin', 'online', 'lastActiveAt'])
        && request.resource.data.keys().hasOnly(['uid', 'admin', 'online', 'lastActiveAt'])
        && request.resource.data.uid == request.auth.uid
        && (!exists(/databases/$(database)/documents/presence/$(sessionId)) || resource.data.uid == request.auth.uid)
        && request.resource.data.admin == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.admin
        && request.resource.data.online is bool
        && request.resource.data.lastActiveAt == request.time;
      allow delete: if false;
    }
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasAll(['email', 'name', 'admin', 'createdAt'])
        && request.resource.data.keys().hasOnly(['email', 'name', 'admin', 'createdAt'])
        && request.resource.data.admin == false
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.createdAt == request.time;
      allow update: if request.auth != null && request.auth.uid == userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100;
      allow delete: if false;
      match /chatReads/{readerId} {
        function canReadChat() {
          return request.auth != null && request.auth.uid == readerId
            && (request.auth.uid == userId || isAdmin());
        }
        allow read: if canReadChat();
        allow create: if canReadChat()
          && request.resource.data.keys().hasAll(['lastReadAt'])
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.lastReadAt <= request.time;
        allow update: if canReadChat()
          && request.resource.data.keys().hasOnly(['lastReadAt'])
          && request.resource.data.lastReadAt is timestamp
          && request.resource.data.lastReadAt <= request.time
          && request.resource.data.lastReadAt >= resource.data.lastReadAt;
        allow delete: if false;
      }
      match /messages/{messageId} {
        function canChat() {
          return request.auth != null && (request.auth.uid == userId || isAdmin());
        }
        function validReply() {
          let reply = request.resource.data.reply;
          return reply is map
            && reply.keys().hasAll(['messageId', 'text', 'senderId'])
            && reply.keys().hasOnly(['messageId', 'text', 'senderId'])
            && reply.messageId is string
            && reply.messageId.size() <= 128
            && reply.messageId.matches('^[^/]+$')
            && reply.text is string
            && reply.senderId is string
            && exists(/databases/$(database)/documents/users/$(userId)/messages/$(reply.messageId))
            && reply.text == get(/databases/$(database)/documents/users/$(userId)/messages/$(reply.messageId)).data.text
            && reply.senderId == get(/databases/$(database)/documents/users/$(userId)/messages/$(reply.messageId)).data.senderId;
        }
        function validAttachment() {
          let file = request.resource.data.attachment;
          return file is map
            && file.keys().hasAll(['path', 'name', 'size', 'type'])
            && file.keys().hasOnly(['path', 'name', 'size', 'type'])
            && file.path == 'chat/' + userId + '/' + request.auth.uid + '/' + messageId + '/attachment'
            && file.name is string && file.name.size() > 0 && file.name.size() <= 255
            && file.type is string && file.type.size() > 0 && file.type.size() <= 255
            && file.size is int && file.size > 0 && file.size <= 20 * 1024 * 1024;
        }
        allow read: if canChat();
        allow create: if canChat()
          && exists(/databases/$(database)/documents/users/$(userId))
          && request.resource.data.keys().hasAll(['text', 'senderId', 'createdAt'])
          && request.resource.data.keys().hasOnly(['text', 'senderId', 'createdAt', 'reply', 'attachment'])
          && (!('reply' in request.resource.data) || validReply())
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && (request.resource.data.text.size() > 0 || 'attachment' in request.resource.data)
          && (!('attachment' in request.resource.data) || validAttachment())
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt == request.time;
        allow update, delete: if false;
      }
    }
  }
}
